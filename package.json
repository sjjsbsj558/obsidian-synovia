{
  "name": "synovia-obsidian",
  "version": "0.2.1",
  "private": true,
  "description": "Local-first knowledge evolution workbench for Obsidian.",
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "check": "npm run test && npm run build",
    "package": "npm run check && node scripts/package.mjs"
  },
  "dependencies": {
    "@codemirror/merge": "6.12.2",
    "@mozilla/readability": "0.6.0",
    "eventsource-parser": "4.1.0",
    "minisearch": "7.2.0",
    "remark": "15.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "obsidian": "1.13.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
